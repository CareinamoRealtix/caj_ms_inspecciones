APP_NAME=ms-inspecciones
ENVIRONMENT=local
LOG_LEVEL=INFO

DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=Caja
DATABASE_USER=postgres
DATABASE_PASSWORD=change-me
DATABASE_SCHEMA=inspecciones
DATABASE_POOL_MIN_SIZE=1
DATABASE_POOL_MAX_SIZE=10
DATABASE_CONNECT_TIMEOUT=5
# disable/allow/prefer/require/verify-ca/verify-full. Contra Aurora/RDS use "require":
# esas instancias suelen rechazar conexiones sin cifrar (pg_hba "no encryption").
DATABASE_SSL_MODE=prefer

AZURE_TENANT_ID=your-tenant-id
AZURE_BACKEND_CLIENT_ID=your-backend-client-id
AZURE_BACKEND_CLIENT_SECRET=your-backend-client-secret

# Habilita temporalmente POST /{id_inspeccion}/levantamiento mientras no exista sincronización
# offline. El catálogo GET /levantamiento/catalogos no depende de esta variable.
ENABLE_DIRECT_LEVANTAMIENTO_ENDPOINT=false

# Prefijo montado delante de todas las rutas. Vacío = sin prefijo. Si no está vacío debe
# empezar con "/" y no terminar en "/" (ej. /v1/inspeccion, /api/v1, o "" para ninguno).
API_PREFIX=/v1/inspeccion

# Webhook de ms-requerimientos (órdenes de servicio) notificado al finalizar un levantamiento
# con servicios_requeridos y/o inspección técnica. Vacío = deshabilitado (se loguea y se omite).
# URL provisional de pruebas dada por el equipo de ms-requerimientos:
#   http://161.97.86.251:8002/v1/requerimientos/webhook-inspecciones
ORDENES_SERVICIO_WEBHOOK_URL=
ORDENES_SERVICIO_WEBHOOK_TIMEOUT=10

# Sincronización offline (HU.12) con AWS Batch. false = los endpoints /sincronizacion (POST y
# GET por job_id) responden 503 sin llamar a AWS (ej. DEV sin la infraestructura desplegada).
# Las credenciales AWS salen de la cadena por defecto de boto3 (rol de EC2/ECS), no del .env.
SINCRONIZACION_HABILITADA=false
AWS_REGION=us-east-1
SINCRONIZACION_BATCH_JOB_QUEUE=
SINCRONIZACION_BATCH_JOB_DEFINITION=
SINCRONIZACION_DYNAMODB_TABLE=
SINCRONIZACION_S3_BUCKET=
SINCRONIZACION_CLOUDFRONT_DOMAIN=
# false = URL de CloudFront sin firmar (Etapa 1). true = firmada (requiere key pair id y clave).
SINCRONIZACION_URL_FIRMADA=false
SINCRONIZACION_CLOUDFRONT_KEY_PAIR_ID=
SINCRONIZACION_CLOUDFRONT_PRIVATE_KEY_PARAM=
SINCRONIZACION_URL_TTL_SEGUNDOS=120
SINCRONIZACION_LONG_POLLING_MAX_SEGUNDOS=25

# Subida de levantamientos por ZIP (HU.12, Etapa 2). Valores: `terraform output variables_para_ms_inspecciones`.
SUBIDA_BATCH_JOB_DEFINITION=
SUBIDA_DYNAMODB_TABLE=
SUBIDA_S3_BUCKET=
FOTOS_S3_BUCKET=
FOTOS_CLOUDFRONT_DOMAIN=
